    <!-- Quick to brighten, lazy to darken, like stock OOS. These override the
         config_autoBrightness*LightDebounce overlay values. -->
    <autoBrightness enabled="True">
        <brighteningLightDebounceMillis>1000</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>4000</darkeningLightDebounceMillis>
    </autoBrightness>

    <!-- No highBrightnessMode block: the whole float range is the panel's
         backlight range, including the 600-800 nit HBM region the kernel maps
         above level 2749 - the same region stock's hbm_lux_table drives for
         auto sunlight boost (575 nits at 40k lux up to 800 at 70k). A time
         budget here would dim the screen back down mid-sunlight; stock has
         none. -->

    <!-- HDR boost without highBrightnessMode: HdrBrightnessModifier reads this
         block directly and, with no HBM block, boosts up to BRIGHTNESS_MAX (the
         ~803-nit backlight ceiling). SF dims SDR layers by the same ratio, so
         SDR content stays at the user's level while HDR highlights get the
         headroom. brightnessMap keys are ambient-lux upper bounds: the cap
         applies below the key, so HDR can't blind in a dark room. -->
    <hdrBrightnessConfig>
        <brightnessMap>
            <point>
                <first>10</first>
                <second>0.433700</second> <!-- below 10 lux cap HDR at ~371 nits -->
            </point>
            <point>
                <first>100</first>
                <second>0.613675</second> <!-- below 100 lux cap HDR at ~570 nits -->
            </point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>1000</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>3000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.15</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.06</screenBrightnessRampDecrease>
        <minimumHdrPercentOfScreenForNbm>0.2</minimumHdrPercentOfScreenForNbm>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <!-- first = SDR nits, second = HDR/SDR boost ratio. Ratios chosen so
             ratio * sdrNits stays within the ~803-nit full-white ceiling and
             tapers to 1.0 at the top. -->
        <sdrHdrRatioMap>
            <point>
                <first>2</first>
                <second>6.0</second>
            </point>
            <point>
                <first>25</first>
                <second>5.0</second>
            </point>
            <point>
                <first>50</first>
                <second>4.0</second>
            </point>
            <point>
                <first>100</first>
                <second>3.0</second>
            </point>
            <point>
                <first>200</first>
                <second>2.4</second>
            </point>
            <point>
                <first>300</first>
                <second>2.0</second>
            </point>
            <point>
                <first>400</first>
                <second>1.7</second>
            </point>
            <point>
                <first>500</first>
                <second>1.5</second>
            </point>
            <point>
                <first>600</first>
                <second>1.3</second>
            </point>
            <point>
                <first>803</first>
                <second>1.0</second>
            </point>
        </sdrHdrRatioMap>
    </hdrBrightnessConfig>

    <screenBrightnessRampFastDecrease>0.5</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.5</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.04</screenBrightnessRampSlowDecrease>
    <!-- Auto-brightness animates upward at the slow rate: 0.05 takes ~14s for a
         dark-room to sunlight swing; 0.25 reaches it in ~3s, close to stock. -->
    <screenBrightnessRampSlowIncrease>0.25</screenBrightnessRampSlowIncrease>
</displayConfiguration>
