<?xml version="1.0" encoding="UTF-8"?>
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2376</height>
            <width>1080</width>
            <density>450</density>
        </density>
        <density>
            <height>3168</height>
            <width>1440</width>
            <density>560</density>
        </density>
    </densityMapping>

    <!-- Framework brightness float maps linearly onto the panel backlight level
         (float = level / 4095; QC HWC scales by qcom,mdss-brightness-max-level).
         The oplus driver (global-hbm-case-id 4) remaps levels through fixed DBV
         buffers: levels 0-2047 are the normal range (backlight_buf, up to
         ~502 nits full-white), 2048-2749 the 500-600 nit region, and above 2749
         it latches the panel HBM commands and runs the 600-800 nit region
         (backlight_600_800nit_buf), reaching ~803.6 nits at level 4095. Nits are
         the full-white values from the stock OOS factory calibration table for
         this panel (salami_imgs my_product/vendor/etc/
         display_brightness_config_samsung1024.xml: kernel level L maps to stock
         table row 4*L below 2048 and row L+6144 above - verified continuous at
         every region seam). -->
    <screenBrightnessMap>
        <point>
            <value>0.000000127</value> <!-- level 3 -->
        </point>
        <point>
            <value>0.000000239</value> <!-- level 4 -->
        </point>
        <point>
            <value>0.000000390</value> <!-- level 5 -->
        </point>
        <point>
            <value>0.000000582</value> <!-- level 6 -->
        </point>
        <point>
            <value>0.000001096</value> <!-- level 8 -->
        </point>
        <point>
            <value>0.000001791</value> <!-- level 10 -->
        </point>
        <point>
            <value>0.000003189</value> <!-- level 13 -->
        </point>
        <point>
            <value>0.000005755</value> <!-- level 17 -->
        </point>
        <point>
            <value>0.000010148</value> <!-- level 22 -->
        </point>
        <point>
            <value>0.000017250</value> <!-- level 28 -->
        </point>
        <point>
            <value>0.000029985</value> <!-- level 36 -->
        </point>
        <point>
            <value>0.000051417</value> <!-- level 46 -->
        </point>
        <point>
            <value>0.000085622</value> <!-- level 58 -->
        </point>
        <point>
            <value>0.000150722</value> <!-- level 75 -->
        </point>
        <point>
            <value>0.000259441</value> <!-- level 96 -->
        </point>
        <point>
